datasource db {
  provider = "postgresql"
  url = env("AUCTION_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output = "../../../node_modules/@prisma/client/auction"
}

enum AuctionStatus {
  INITIALIZING
  PENDING
  ACTIVE
  ENDED
  CANCELLED
}

model Auction {
  id String @id @default(uuid())
  productId String
  sellerId String
  productTitle String?
  productThumbnail String?
  startingPrice Decimal @db.Decimal(18,2)
  currentPrice Decimal @db.Decimal(18,2)
  bidIncrement Decimal @db.Decimal(18,2)
  currency String @default("VND")
  startTime DateTime
  endTime DateTime
  status AuctionStatus @default(INITIALIZING)
  leadingBidderId String?
  winnerId String?
  finalPrice Decimal? @db.Decimal(18,2)
  version Int @default(0)
  initializationRequest Json
  initializationError String?
  bids Bid[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, endTime])
  @@index([status, startTime])
  @@index([sellerId, createdAt])
  @@index([productId, createdAt])
}

model Bid {
  id String @id @default(uuid())
  auctionId String
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  bidderId String
  amount Decimal @db.Decimal(18,2)
  createdAt DateTime @default(now())
  @@index([auctionId, createdAt])
}

model PlatformProbe {
  id String @id @default(uuid())
  runId String
  kind String
  data Json
  createdAt DateTime @default(now())
  @@unique([runId, kind])
}

model OutboxEvent {
  id String @id
  aggregateId String
  aggregateVersion Int
  exchange String
  routingKey String
  envelope Json
  status String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  leaseOwner String?
  lastError String?
  createdAt DateTime @default(now())
  sentAt DateTime?
  @@unique([aggregateId, aggregateVersion])
  @@index([status, availableAt])
}

model IdempotencyRecord {
  id String @id @default(uuid())
  actorId String
  operation String
  key String
  requestHash String
  response Json?
  statusCode Int?
  createdAt DateTime @default(now())
  @@unique([actorId, operation, key])
}
