# Chạy npm run setup:dev để tự động sinh local secrets và keys
# Postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=root_db
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# Rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=auction
RABBITMQ_PASSWORD=
RABBITMQ_URL=

# Krakend
API_GATEWAY_PORT=8080

# Services
AUTH_PORT=3001
PRODUCT_PORT=3002
AUCTION_PORT=3003
ORDER_PORT=3004
PAYMENT_PORT=3005
NOTIFICATION_PORT=3006

# Database
AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=
PRODUCT_DB_USER=product_app
PRODUCT_DB_PASSWORD=
AUCTION_DB_USER=auction_app
AUCTION_DB_PASSWORD=
ORDER_DB_USER=order_app
ORDER_DB_PASSWORD=
PAYMENT_DB_USER=payment_app
PAYMENT_DB_PASSWORD=
NOTIFICATION_DB_USER=notification_app
NOTIFICATION_DB_PASSWORD=
AUTH_DATABASE_URL=
PRODUCT_DATABASE_URL=
AUCTION_DATABASE_URL=
ORDER_DATABASE_URL=
PAYMENT_DATABASE_URL=
NOTIFICATION_DATABASE_URL=
SEED_PASSWORD=

# JWT Authentication
JWT_ISSUER=online-auction
JWT_AUDIENCE=online-auction-api
JWT_KEY_ID=auction-dev-v1
JWT_PRIVATE_KEY_PATH=.local/keys/private.pem
JWT_PUBLIC_KEY_PATH=.local/keys/public.pem
JWT_REFRESH_SECRET=

# Infrastructure / Others
INTERNAL_AUCTION_KEY=
INTERNAL_PAYMENT_KEY=
PLATFORM_ADMIN_KEY=
PLATFORM_DEMO_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOCAL_GID=
NODE_ENV=development
