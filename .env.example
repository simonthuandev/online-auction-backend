# ==========================================
# 1. API GATEWAY & MICROSERVICES PORTS
# ==========================================
API_GATEWAY_PORT=8080

AUTH_PORT=3001
PRODUCT_PORT=3002
AUCTION_PORT=3003
ORDER_PORT=3004
PAYMENT_PORT=3005
NOTIFICATION_PORT=3006

# ==========================================
# 2. INFRASTRUCTURE DOCKER CONFIGURATIONS
# ==========================================
# PostgreSQL Database Engine
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=root_db

# Redis Cache & Realtime State
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# RabbitMQ Event Bus
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# ==========================================
# 3. LOGICAL DATABASES (PRISMA PER-SERVICE)
# ==========================================
AUTH_DATABASE_URL="postgresql://admin:password@localhost:5432/auth_db"
PRODUCT_DATABASE_URL="postgresql://admin:password@localhost:5432/product_db"
AUCTION_DATABASE_URL="postgresql://admin:password@localhost:5432/auction_db"
ORDER_DATABASE_URL="postgresql://admin:password@localhost:5432/order_db"
PAYMENT_DATABASE_URL="postgresql://admin:password@localhost:5432/payment_db"
NOTIFICATION_DATABASE_URL="postgresql://admin:password@localhost:5432/notification_db"

# ==========================================
# 4. SECURITY & AUTH (SHARED SECRETS)
# ==========================================
# Chạy `npm run gen:jwk` sau khi điền JWT_ACCESS_SECRET để generate krakend/jwk.json
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ==========================================
# 5. THIRD-PARTY INTEGRATIONS (OPTIONAL)
# ==========================================
