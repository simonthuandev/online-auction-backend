{
  "name": "online-auction-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "build:common": "nest build common",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:auth": "nest start auth-service --watch",
    "start:product": "nest start product-service --watch",
    "start:auction": "nest start auction-service --watch",
    "start:order": "nest start order-service --watch",
    "start:payment": "nest start payment-service --watch",
    "start:notification": "nest start notification-service --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/auth-service/main",
    "lint": "oxlint --type-aware apps/ libs/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate:all": "prisma generate --schema=apps/auth-service/prisma/schema.prisma && prisma generate --schema=apps/product-service/prisma/schema.prisma && prisma generate --schema=apps/auction-service/prisma/schema.prisma && prisma generate --schema=apps/order-service/prisma/schema.prisma && prisma generate --schema=apps/payment-service/prisma/schema.prisma && prisma generate --schema=apps/notification-service/prisma/schema.prisma",
    "prisma:push:all": "dotenv -e .env -- bash -c 'prisma db push --schema=apps/auth-service/prisma/schema.prisma && prisma db push --schema=apps/product-service/prisma/schema.prisma && prisma db push --schema=apps/auction-service/prisma/schema.prisma && prisma db push --schema=apps/order-service/prisma/schema.prisma && prisma db push --schema=apps/payment-service/prisma/schema.prisma && prisma db push --schema=apps/notification-service/prisma/schema.prisma'"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/microservices": "^12.1.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/websockets": "^12.1.3",
    "@prisma/client": "^6.4.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.8",
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^6.4.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  },
  "allowScripts": {
    "prisma@6.4.1": true,
    "@prisma/client@6.4.1": true,
    "@prisma/engines@6.4.1": true
  }
}
