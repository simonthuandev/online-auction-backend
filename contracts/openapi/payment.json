            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "orderId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "paymentMethod": {
                    "description": "COD (cash on delivery) or VNPAY. Choosing COD does not confirm payment; cash collection must be confirmed before payment.succeeded is emitted.",
                    "enum": [
                      "COD",
                      "VNPAY"
                    ]
                  }
                },
                "required": [
                  "orderId",
                  "paymentMethod"
                ],
                "additionalProperties": false
              }
            }
          }
