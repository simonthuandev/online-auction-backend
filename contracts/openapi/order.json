  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-service-key"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "details": {}
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "degraded",
              "live"
            ]
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "service",
          "status"
        ],
        "additionalProperties": false
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "auctionId": {
            "type": "string",
            "format": "uuid"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "buyerId": {
            "type": "string",
            "format": "uuid"
          },
          "sellerId": {
            "type": "string",
            "format": "uuid"
          },
          "totalAmount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,15})$",
            "examples": [
              "100000"
            ]
          },
          "currency": {
            "const": "VND"
          },
          "status": {
            "enum": [
              "PENDING_PAYMENT",
              "PAID",
              "CANCELLED",
              "COMPLETED"
            ]
          },
          "productTitle": {
            "type": "string"
          },
          "productThumbnail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "auctionId",
          "productId",
          "buyerId",
          "sellerId",
          "totalAmount",
          "currency",
          "status",
          "productTitle",
          "productThumbnail"
        ],
        "additionalProperties": false
      },
      "PaymentContext": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "buyerId": {
            "type": "string",
            "format": "uuid"
          },
          "sellerId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,15})$",
            "examples": [
              "100000"
            ]
          },
          "currency": {
            "const": "VND"
          },
          "status": {
            "const": "PENDING_PAYMENT"
          }
        },
        "required": [
          "orderId",
          "buyerId",
          "sellerId",
          "amount",
          "currency",
          "status"
        ],
        "additionalProperties": false
      },
      "OrderPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "additionalProperties": false
      }
    }
  }
